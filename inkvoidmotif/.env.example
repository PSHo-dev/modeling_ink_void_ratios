# Configure at least one provider. Never commit a real key.
OPENAI_API_KEY=your-openai-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# Optional automatic-provider preference when both keys exist: openai or nvidia.
# INKVOIDMOTIF_PROVIDER=nvidia

# OpenAI defaults.
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2

# NVIDIA Responses API defaults.
NVIDIA_BASE_URL=https://inference-api.nvidia.com
NVIDIA_TEXT_MODEL=azure/openai/gpt-5.5
NVIDIA_RESPONSES_MODEL=openai/openai/gpt-5.5
NVIDIA_IMAGE_MODEL=openai/openai/gpt-5.5
NVIDIA_IMAGE_TRANSPORT=responses

# Provider-call safeguards (10-900 seconds, 0-3 retries).
INKVOIDMOTIF_API_TIMEOUT=300
INKVOIDMOTIF_API_RETRIES=1

# Optional local storage and trusted-input limits.
# INKVOIDMOTIF_STUDIO_RUNS=/absolute/path/to/studio-runs
# INKVOIDMOTIF_MAX_IMAGE_PIXELS=120000000

# Required together only for --share or a non-loopback --host.
# INKVOIDMOTIF_STUDIO_USER=collaborator
# INKVOIDMOTIF_STUDIO_PASSWORD=choose-a-long-random-password
